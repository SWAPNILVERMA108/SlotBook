# Copy this file to  .env.docker  and edit it. NEVER commit .env.docker to Git.
# Used by docker-compose.yml for ALL containers.

# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-text-at-least-50-characters-long-xxxxxxxxxxxx
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Keep these off when you test on http://localhost. Switch them on behind real https (see docs/DEPLOY.md).
HTTPS_ONLY=False
BEHIND_PROXY=False
NUM_PROXIES=0

# ---- PostgreSQL (the db container reads the first three, the app reads DATABASE_URL) ----
POSTGRES_USER=slotbook
POSTGRES_PASSWORD=change-me-use-letters-and-digits-only
POSTGRES_DB=slotbook
# The password here must be the same as above. "db" is the name of the database container.
DATABASE_URL=postgres://slotbook:change-me-use-letters-and-digits-only@db:5432/slotbook

# ---- Razorpay (TEST keys) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me
